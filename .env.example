# Copy to .env.local for local development. On Vercel, set these in
# Project Settings -> Environment Variables (the Neon integration adds the DB ones).

# Neon Postgres: pooled URL for the app, direct (unpooled) URL for migrations.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# Vercel preview builds: set to 1 only when each preview has its own Neon branch.
# MIGRATE_ON_PREVIEW=1

# Better Auth. Secret: `openssl rand -base64 32` (different per environment).
# BETTER_AUTH_URL: local http://localhost:3000; production https://<your-domain>.
# On Vercel previews it may be left unset: the app falls back to the deployment URL.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# First admin for `npm run db:seed` (local / one-off). Change the password after first login.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_NAME=Administrateur
SEED_ADMIN_PASSWORD=
